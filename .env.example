# Supabase uses the newer API key format: a publishable key client-side and a
# secret key server-side only. These are not the legacy anon/service_role JWTs
# (eyJ...) — if a key you are given starts with eyJ, it is the old format.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_...

# Picks feature secrets
SUPABASE_SERVICE_KEY=sb_secret_...
RESEND_API_KEY=re_...
INVITE_FROM_EMAIL=picks@yourdomain.com
# Note the -cg7 suffix: Cloudflare assigned it because nfl-picks.pages.dev
# was already taken by another account. That bare domain is NOT this app.
PUBLIC_SITE_URL=https://nfl-picks-cg7.pages.dev
